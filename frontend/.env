# API Configuration
# For local development with proxy, use /api (Vite will proxy requests)
VITE_API_URL=/api

# For direct connection to backend (uncomment if needed)
# VITE_API_URL=http://localhost:8082/api

# For production server (uncomment when deploying, not for local dev)
# VITE_API_URL=http://172.30.80.11:31030/api
